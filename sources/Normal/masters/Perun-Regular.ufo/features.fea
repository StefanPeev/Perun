#> classes
#/> otclasses
@aalt = [Scedilla scedilla uni0162 uni0163];
@aalt2 = [Scommaaccent scommaaccent uni0162 uni0163];
@loclcyr = [uni0414 uni041B uni0424 uni0432 uni0433 uni0434 uni0436 uni0437 uni0438 uni0439 uni043A uni043B uni043F uni0442 uni0443 uni0444 uni0446 uni0447 uni0448 uni0449 uni044A uni044B uni044C uni044E uni045D];
@loclBGR = [uni0414.loclBGR uni041B.loclBGR uni0424.loclBGR uni0432.loclBGR uni0433.loclBGR uni0434.loclBGR uni0436.loclBGR uni0437.loclBGR uni0438.loclBGR uni0439.loclBGR uni043A.loclBGR uni043B.loclBGR uni043F.loclBGR uni0442.loclBGR uni0443.loclBGR uni0444.loclBGR uni0446.loclBGR uni0447.loclBGR uni0448.loclBGR uni0449.loclBGR uni044A.loclBGR uni044B.loclBGR uni044C.loclBGR uni044E.loclBGR uni045D.loclBGR];
@ss01 = [uni0414 uni041B uni0424 uni0432 uni0433 uni0434 uni0436 uni0437 uni0438 uni0439 uni043A uni043B uni043F uni0442 uni0443 uni0444 uni0446 uni0447 uni0448 uni0449 uni044A uni044B uni044C uni044E uni045D];
@ss012 = [uni0414.loclBGR uni041B.loclBGR uni0424.loclBGR uni0432.loclBGR uni0433.loclBGR uni0434.loclBGR uni0436.loclBGR uni0437.loclBGR uni0438.loclBGR uni0439.loclBGR uni043A.loclBGR uni043B.loclBGR uni043F.loclBGR uni0442.loclBGR uni0443.loclBGR uni0444.loclBGR uni0446.loclBGR uni0447.loclBGR uni0448.loclBGR uni0449.loclBGR uni044A.loclBGR uni044B.loclBGR uni044C.loclBGR uni044E.loclBGR uni045D.loclBGR];
#/< otclasses
#< classes

#/> classes
#/> otclasses
#/< otclasses
#/< classes

#/> kernclasses
#/< kernclasses
#/< classes

#> languagesystem
languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem latn AZE;
languagesystem latn CRT;
languagesystem latn MOL;
languagesystem latn ROM;
languagesystem latn TRK;
languagesystem cyrl dflt;
languagesystem cyrl BGR;
languagesystem cyrl SRB;
languagesystem grek dflt;
#< languagesystem

#
# Lookup definitions
#

lookup loclcyr_loclBGR {
# GSUB lookup 4, type 11 (Single)
  sub @loclcyr by @loclBGR;
} loclcyr_loclBGR;

#
# Feature definitions
#






feature aalt {
# Access All Alternates

#> feature
  feature locl;
  feature ss01;
  feature hist;
#< feature
} aalt;
feature locl {
# Localized Forms

#> feature
  script latn; # Latin
    language AZE ; # Azerbaijani

    lookup locl_latn {
    # GSUB lookup 7, type 11 (Single)
      sub i by i.loclTRK;
    } locl_latn;

    language TRK ; # Turkish
    lookup locl_latn;

    language CRT ; # Crimean Tatar
    lookup locl_latn;

    language MOL; # Moldavian
      sub Scedilla by Scommaaccent;
      sub scedilla by scommaaccent;
      sub uni0162 by uni021A;
      sub uni0163 by uni021B;

    language ROM; # Romanian
      sub Scedilla by Scommaaccent;
      sub scedilla by scommaaccent;
      sub uni0162 by uni021A;
      sub uni0163 by uni021B;

  script cyrl; # Cyrillic
    language BGR; # Bulgarian
      sub uni0414 by uni0414.loclBGR;
      sub uni041A by uni041A.loclBGR;
      sub uni041B by uni041B.loclBGR;
      sub uni0424 by uni0424.loclBGR;
      sub uni0432 by uni0432.loclBGR;
      sub uni0433 by uni0433.loclBGR;
      sub uni0434 by uni0434.loclBGR;
      sub uni0436 by uni0436.loclBGR;
      sub uni0437 by uni0437.loclBGR;
      sub uni0438 by uni0438.loclBGR;
      sub uni0439 by uni0439.loclBGR;
      sub uni043A by uni043A.loclBGR;
      sub uni043B by uni043B.loclBGR;
      sub uni043F by uni043F.loclBGR;
      sub uni0442 by uni0442.loclBGR;
      sub uni0443 by uni0443.loclBGR;
      sub uni0444 by uni0444.loclBGR;
      sub uni0446 by uni0446.loclBGR;
      sub uni0447 by uni0447.loclBGR;
      sub uni0448 by uni0448.loclBGR;
      sub uni0449 by uni0449.loclBGR;
      sub uni044A by uni044A.loclBGR;
      sub uni044B by uni044B.loclBGR;
      sub uni044C by uni044C.loclBGR;
      sub uni044E by uni044E.loclBGR;
      sub uni045D by uni045D.loclBGR;

    language SRB; # Serbian
      sub uni0431 by uni0431.loclSRB;

#< feature
} locl;






feature ordn {
# Ordinals

#> feature
  sub [zero one two three four five six seven eight nine] [A a]' by ordfeminine;
  sub [zero one two three four five six seven eight nine] [O o]' by ordmasculine;
  sub N o period by uni2116;
#< feature
} ordn;






feature ss01 {
# Stylistic Set 01–20

  featureNames {
    name "Bulgarian Cyrillic";
  };

#> feature
     lookup loclcyr_loclBGR;
#< feature
} ss01;






feature liga {
# Standard Ligatures

#> feature
  sub f f i by uniFB03;
  sub f f l by uniFB04;
  sub f f by uniFB00;
  sub f i by uniFB01;
  sub f l by uniFB02;
  sub longs t by uniFB05;
  sub s t by uniFB06;
#< feature
} liga;






feature dlig {
# Discretionary Ligatures

#> feature
  sub f f j by f_f_j.dlig;
  sub f j by f_j.dlig;
  sub f t by f_t.dlig;
  sub u a e a e d by aed.dlig;
#< feature
} dlig;






feature hist {
# Historical Forms

#> feature
  sub s by longs;
#< feature
} hist;






